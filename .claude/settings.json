{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|mcp__lean-ctx__ctx_patch|mcp__lean-ctx__ctx_call",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/writing-rules/scripts/inject-writing-rules.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__lean-ctx__ctx_shell|mcp__lean-ctx__shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/engine/verify/block-destructive-git.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__lean-ctx__ctx_shell|mcp__lean-ctx__shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/engine/verify/block-invalid-branch-push.sh engine/verify/check-branch-name.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__lean-ctx__ctx_shell|mcp__lean-ctx__shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/engine/verify/block-unverified-push.sh engine/verify/verify.mjs"
          }
        ]
      }
    ]
  }
}
